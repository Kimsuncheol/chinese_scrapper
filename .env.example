SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chinese_scrapper

# Kakao Developers > My Application > App Keys / Kakao Login
KAKAO_REST_API_KEY=
# Only needed if "Client Secret" is enabled in Kakao Login > Security
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5000/auth/kakao/callback
# Comma separated. account_email requires the consent item to be enabled in the console.
KAKAO_SCOPE=profile_nickname,profile_image
